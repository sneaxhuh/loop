FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LOOP_HOSTED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY loop_app ./loop_app
COPY shootout ./shootout
COPY fixtures ./fixtures

CMD ["sh", "-c", "python -m loop_app --host 0.0.0.0 --port ${PORT:-80} --workspace /tmp/loop-workspace"]
